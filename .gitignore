# Dependencies
node_modules/

# Build output
dist/

# Environment files
.env
.env.local
.env.*.local

# Test coverage
coverage/
.nyc_output/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temporary files
*.tsbuildinfo

# Scripts (run them locally, don't commit)
scripts/

# Local database backups
.backups/

# Dependency docs directories under node_modules only. A bare `docs/` also
# swallows backend/docs, and git cannot re-include a path whose parent
# directory is excluded.
**/node_modules/**/docs/
